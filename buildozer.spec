[app]
title = Fazlaka
package.name = fazlaka
package.domain = org.fazlaka.fazlaka
source.dir = .
source.include_exts = py
version = 1.0
requirements = python3,kivy,pyjnius
orientation = portrait
fullscreen = 0
android.permissions = INTERNET,ACCESS_NETWORK_STATE,BLUETOOTH,BLUETOOTH_ADMIN,BLUETOOTH_CONNECT,BLUETOOTH_SCAN,ACCESS_FINE_LOCATION
android.api = 31
android.minapi = 21
android.ndk = 23b
android.accept_sdk_license = True
android.archs = arm64-v8a
p4a.branch = develop
[buildozer]
log_level = 1
warn_on_root = 0
